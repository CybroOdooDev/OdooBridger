# OdooBridger — run `python3 deploy/make-env.py` to create deploy/.env with the secrets filled in.
# (Copying this file by hand leaves them blank and docker compose refuses to start.) Or by hand:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=
ENVIRONMENT=development

CORE_JWT_SECRET=
CORE_MASTER_KEY=
BIOBRIDGE_JWT_SECRET=
BIOBRIDGE_MASTER_KEY=
# Shared by the core and BioBridge: proves BioBridge when it trades SSO codes.
BIOMETRIC_CLIENT_SECRET=

# A fixed staff login for both consoles (core /staff and BioBridge's own).
STAFF_EMAIL=
STAFF_PASSWORD=

# Local addresses; in production use your https:// hostnames.
CORE_PUBLIC_URL=http://localhost:8000
BIOMETRIC_PUBLIC_URL=http://localhost:8001
SITE_URL=

# Production (docker-compose.prod.yml)
SITE_DOMAIN=odoobridger.com
CORE_DOMAIN=app.odoobridger.com
BIOMETRIC_DOMAIN=biometric.odoobridger.com
ACME_EMAIL=
ADMS_PORT=8081
ADMS_SERVER_HOST=biometric.odoobridger.com

# Email (verification, invitations, resets, lead alerts)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@odoobridger.com
SALES_EMAIL=
# Company details shown beside the website's contact form (empty = hidden).
# --- Customer Odoo connections (set in the portal, sent to services) ---------
# Allow Odoo addresses in private networks (localhost, 10.x, 192.168.x).
# Empty: allowed unless ENVIRONMENT=production. Inside Docker, a test Odoo on
# your own machine is http://host.docker.internal:8069, not localhost.
ODOO_ALLOW_PRIVATE_TARGETS=
# BioBridge's own calls (Odoo, biometric servers): private addresses refused
# unless true. Customers use a public IP or domain with the port forwarded.
# Set true to test with a terminal or Odoo on your own network.
BIOBRIDGE_ALLOW_PRIVATE_TARGETS=false
# How often (minutes) the core asks each service whether it can still work on Odoo.
ODOO_READINESS_MINUTES=15

COMPANY_NAME=Cybrosys Technologies
CONTACT_EMAIL=
CONTACT_PHONE=
CONTACT_ADDRESS=
CONTACT_HOURS=
COMPANY_WEBSITE=

# Stripe (or set the keys in the staff console → Payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
